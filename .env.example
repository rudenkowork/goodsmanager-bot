BOT_TOKEN=1234567890:replace_with_botfather_token
MAIN_ADMIN_TELEGRAM_USERNAME=timarudy

# Default local mode. Use webhook on Render Free web services.
BOT_MODE=polling

# GoodsCRM integration. Base URL points to the CRM app, not the bot.
# BOT_INGEST_SECRET must match the CRM server variable with the same name.
# When these are set, the bot stores runtime state in the CRM database through /api/bot/store.
# GOODSCRM_BASE_URL=https://your-goodscrm.example
# BOT_INGEST_SECRET=replace_with_a_long_random_secret

# Render webhook mode:
# BOT_MODE=webhook
# WEBHOOK_BASE_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=replace_with_a_long_random_value_using_letters_numbers_underscores_or_dashes

# Optional local backup path for Telegram UX/session state.
# CRM remains the canonical database; do not set DATABASE_URL in this bot.
# If CRM integration is not configured, the bot writes only to ./data/store.json.
# STORE_PATH=/data/store.json
